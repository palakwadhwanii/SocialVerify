# SocialVerify credential inventory
# This file is a reference, not loaded automatically by the application.
# Put each value in the component .env file shown below. Never commit real keys.

# client/.env - Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=

# server/.env - News, social platforms, database, and signed sessions
NEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MASTODON_ACCESS_TOKEN=
JWT_SECRET=
DATABASE_URL=

# service/.env - AI models, fact-check search, agent authentication, tracing
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
CREWAI_MODEL_API_KEY=
ADK_MODEL_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
A2A_AUTH_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
