# ==============================================================================
# SocialVerify AI Service Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
SERVER_BASE_URL=http://localhost:9000
ALLOWED_ORIGINS=*

# LLM Providers (Groq / NVIDIA / Google Gemini / OpenAI)
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=

# CrewAI Research Coordinator Provider
CREWAI_MODEL_API_KEY=
CREWAI_MODEL=groq/llama-3.3-70b-versatile

# Google Agent Development Kit (ADK) Provider
ADK_MODEL_API_KEY=
ADK_MODEL=gemini-3.5-flash

# Model Context Protocol (MCP) Services
SEARCH_MCP_URL=http://localhost:8001
EVIDENCE_MCP_URL=http://localhost:8002

# Agent2Agent (A2A) Protocol Endpoint & Authentication
ADK_A2A_BASE_URL=http://localhost:8000/a2a
A2A_AUTH_TOKEN=socialverify-a2a-secret-key-token

# Observability & Distributed Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Guardrails & Operational Limits
MAX_INPUT_LENGTH=2000
MAX_TOOL_RESULTS=20
MCP_TOOL_TIMEOUT_SECONDS=10
INVESTIGATION_WINDOW_DAYS=30

# Mastodon Configuration (Federated Social Network Provider)
MASTODON_INSTANCES=mastodon.social,mastodon.online,fosstodon.org,masto.ai,infosec.exchange
MASTODON_ACCESS_TOKEN=
MASTODON_REQUEST_TIMEOUT=15
